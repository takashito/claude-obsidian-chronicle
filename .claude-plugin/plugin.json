{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "obsidian-chronicle",
  "displayName": "obsidian chronicle",
  "version": "0.2.3",
  "description": "Auto-records Claude Code sessions as structured Obsidian notes + Daily Note entries (via the SessionEnd/PreCompact hooks and /done), and ships the obsidian-vault agent — the unified handler for all Obsidian vault work (create, edit, search, organize notes, tasks, canvases, bases). Configure with /obsidian-chronicle:setup.",
  "author": {
    "name": "takashito",
    "url": "https://github.com/takashito"
  },
  "homepage": "https://github.com/takashito/claude-obsidian-chronicle",
  "repository": "https://github.com/takashito/claude-obsidian-chronicle",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "session-summary",
    "daily-notes",
    "journaling",
    "knowledge-management",
    "hooks",
    "claude-code"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-summary.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REASON_OVERRIDE=precompact bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-summary.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
