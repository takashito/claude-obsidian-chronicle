# obsidian-chronicle configuration
#
# Two valid locations (project overrides plugin):
#   • Plugin-wide:  <this plugin's root>/.env       (applies to every project)
#   • Per-project:  <repo root>/.env                (only when Claude is launched there)
#
# Generate interactively with `/obsidian-chronicle:setup` — it asks where to save.
#
# Both `$HOME/...` and `~/...` work for paths.
# Precedence (low → high): defaults → plugin .env → project .env → shell env.
# Only keys prefixed with OBSIDIAN_ are read — your project's other vars
# (DB_PASSWORD, API_KEY, etc.) are ignored, so a shared repo .env is safe.

# Where session summary notes are written.
OBSIDIAN_SESSIONS_DIR=~/obsidian/02_Sessions

# Where today's daily note lives. Default is <sessions-dir>/Daily Notes.
OBSIDIAN_DAILY_DIR=~/obsidian/02_Sessions/Daily Notes

# Model used by `claude -p` to generate summaries.
# Options: haiku (fast/cheap, recommended), sonnet, opus.
OBSIDIAN_CHRONICLE_MODEL=haiku

# Append-only activity log for this plugin's hooks.
OBSIDIAN_CHRONICLE_LOG=~/.claude/session-summary.log

# Skip thresholds for the extracted conversation (user/assistant text only,
# tool I/O dropped).
#   MIN: skip below this (empty / trivial session)
#   MAX: skip above this — protects claude -p from "Prompt is too long".
#        Tune to your model's context budget:
#          200 KB  ≈ comfortable Haiku zone (≈ 50 K tokens)
#          500 KB  ≈ Sonnet
#          1 MB+   ≈ Opus / aggressive
OBSIDIAN_CHRONICLE_MIN_BYTES=200
OBSIDIAN_CHRONICLE_MAX_BYTES=1000000
